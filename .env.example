# LLM (chat + embeddings both go through OpenRouter)
OPENROUTER_API_KEY=

# Telegram bot (BotFather)
TELEGRAM_BOT_TOKEN=
# Allowlisted chat ID — only Patrick's chat can talk to the bot
TELEGRAM_OWNER_CHAT_ID=

# Postgres
DATABASE_URL=postgresql://patrick2:patrick2@localhost:5432/patrick2

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Optional: webhook URL when running on Railway
TELEGRAM_WEBHOOK_URL=

# Moltbook subagent (used by src/agent/subagents/moltbook.ts)
MOLTBOOK_API_KEY=
# Sokosumi / masumi-agent-messenger token (used by Moltbook subagent for Elena thread replies)
SOKOSUMI_API_KEY=

# Google OAuth (Calendar + Gmail). One client covers all accounts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Primary account refresh token (default).
GOOGLE_REFRESH_TOKEN=
# Additional Gmail accounts: GOOGLE_REFRESH_TOKEN_<NAME> (e.g. _PERSONAL, _WORK).
# The lowercase <name> is what the agent passes as `account` to gmail tools.
# To add: run `npx tsx scripts/google-oauth.ts <name>`, sign in with that
# Google account, paste the printed env var on Railway, then restart.
# GOOGLE_REFRESH_TOKEN_PERSONAL=

# WHOOP OAuth (Developer API). Register an app at developer.whoop.com with
# redirect URI http://localhost:8765/oauth/callback, then run:
#   WHOOP_CLIENT_ID=... WHOOP_CLIENT_SECRET=... npx tsx scripts/whoop-oauth.ts
# Paste the printed WHOOP_REFRESH_TOKEN here / on Railway.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REFRESH_TOKEN=
